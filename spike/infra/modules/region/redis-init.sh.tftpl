#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get -o Acquire::Retries=5 update
apt-get install -y curl ca-certificates awscli python3-venv jq
# Redis Software runs its own DNS service on port 53.
mkdir -p /etc/systemd/resolved.conf.d
printf '[Resolve]\nDNSStubListener=no\n' > /etc/systemd/resolved.conf.d/redis.conf
ln -sf /run/systemd/resolve/resolv.conf /etc/resolv.conf
systemctl restart systemd-resolved
mkdir -p /opt/session-spike/installer
cd /opt/session-spike/installer
curl --fail --location --retry 3 '${installer_url}' --output redis.tar
printf '%s  redis.tar\n' '${installer_sha256}' | sha256sum --check -
tar xf redis.tar
installer=$(find . -name install.sh -type f -print -quit)
"$installer" -y
mkdir -p /opt/session-spike
printf 'installed\n' > /opt/session-spike/installed
